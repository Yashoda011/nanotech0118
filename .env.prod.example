# Production env — copy to `.env.prod`, fill, then:
# docker compose --env-file .env.prod up -d --build

# Postgres
POSTGRES_USER=nanosphere
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=nanosphere

# Backend (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=CHANGE-ME-64-hex-chars
# Public site origin(s), comma-separated — NO localhost here
CORS_ORIGINS=https://example.com
ADMIN_EMAILS=admin@example.com
FREE_OFFER_ENDS_AT=2026-10-31T00:00:00+00:00
RESEARCH_API_URL=https://api.semanticscholar.org/graph/v1/paper/search

# Frontend build — public API base URL (no trailing slash)
VITE_API_URL=https://api.example.com
